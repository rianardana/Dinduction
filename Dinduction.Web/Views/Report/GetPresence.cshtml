@model Dinduction.Web.Models.ParticipantUserVM
@{
    ViewData["Title"] = "Training Report";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header Card -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 border border-gray-100">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="bg-blue-500 p-3 rounded-xl">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Admin Training Report</h1>
                        <p class="text-gray-500 mt-1">View and manage all training attendance</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="flex justify-center mb-6">
            <div class="inline-flex rounded-xl shadow-sm bg-white border border-gray-200 p-1">
                <a href="@Url.Action("GetPresence", "Report")"
                   class="px-6 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 flex items-center space-x-2"
                   style="background-color:#2563eb; color:white; box-shadow:0 1px 2px rgba(0,0,0,0.1);">
                    <span>&#127891;</span> <span>Induction</span>
                </a>
                <a href="@Url.Action("RefreshReportAdmin", "Report")"
                   class="px-6 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 flex items-center space-x-2"
                   style="color:#6b7280;">
                    <span>&#128260;</span> <span>Refresh</span>
                </a>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="bg-white rounded-2xl shadow-md p-6 mb-6 border border-gray-100">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="md:col-span-1">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Select Date
                    </label>
                    <input type="text" id="datepicker" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:border-blue-500 transition-all duration-200 shadow-sm" autocomplete="off" placeholder="Pick a date" />
                </div>
                <div class="md:col-span-2 lg:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                        Training Name
                    </label>
                    <select id="Computer_DropDown" name="TrainingId" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:border-blue-500 transition-all duration-200 shadow-sm">
                        <option value="">-- Select Training --</option>
                    </select>
                </div>
                <div class="flex flex-col space-y-3 md:col-span-2 lg:col-span-2">
                    <button type="button" id="btnPreviewForm" class="w-full px-4 py-3 font-semibold rounded-lg transition-all duration-200 flex items-center justify-center space-x-2 shadow-md" style="background-color: #2563eb; color: #ffffff;">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Preview Form</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- DataTable Card -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
            <div class="px-6 py-4 bg-gradient-to-r from-blue-500 to-indigo-600 flex items-center justify-between">
                <h2 class="text-xl font-bold text-white">Attendance List</h2>
                <div class="flex items-center space-x-4">
                    <span id="recordCount" class="text-blue-100 text-sm font-medium"></span>
                    <button id="btnExcel" class="px-4 py-2 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-all duration-200 flex items-center space-x-2 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>Export Excel</span>
                    </button>
                </div>
            </div>
            
            <div class="p-6 overflow-x-auto">
                <table id="presenceTable" class="display nowrap w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No Badge</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee Name</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Training Date</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Training Type</th>
                            <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider" style="width: 160px;">Download Result</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200"></tbody>
                </table>
                
                <div id="emptyState" class="hidden text-center py-12">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <p class="mt-4 text-gray-500">Select a date and training to view attendance</p>
                </div>
            </div>
        </div>

        <div class="text-center mt-8 mb-6">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center px-6 py-3 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm" style="background-color: #2563eb;">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Back to Home
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.dataTables.min.css" asp-append-version="true" />
    <script src="~/js/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/js/dataTables.v2.min.js" asp-append-version="true"></script>
    <script src="~/js/xlsx.full.min.js" asp-append-version="true"></script>

    <script>
    $(document).ready(function () {
        var trainingDates = [];
        var table;

        $.ajax({
            url: '@Url.Action("GetInductionTrainingDates", "Report")',
            method: 'GET',
            success: function (data) {
                trainingDates = Array.isArray(data) ? data : [];
                initializeDatepicker();
            },
            error: function () { initializeDatepicker(); }
        });

        function initializeDatepicker() {
            $("#datepicker").datepicker({
                dateFormat: "yy-mm-dd",
                beforeShowDay: function (date) {
                    var dateStr = $.datepicker.formatDate("yy-mm-dd", date);
                    if (trainingDates.indexOf(dateStr) !== -1) {
                        return [true, "training-day", "Ada Training Induction"];
                    }
                    return [true, "", ""];
                },
                onSelect: function (dateText) {
                    loadTrainings(dateText);
                    loadTable();
                }
            });
            
            if(!$("#datepicker").val()) {
                var today = new Date();
                var todayStr = $.datepicker.formatDate("yy-mm-dd", today);
                $("#datepicker").val(todayStr);
                loadTrainings(todayStr);
                loadTable();
            }
        }

        function loadTrainings(date) {
            $.getJSON('@Url.Action("GetTrainingsByDate", "Report")', { date: date }, function (data) {
                var ddl = $("#Computer_DropDown");
                ddl.empty();
                ddl.append($('<option>').val("").text("-- Select Training --"));
                $.each(data, function (i, item) {
                    ddl.append($('<option>').val(item.value).text(item.text));
                });
            });
        }

        table = $('#presenceTable').DataTable({
            ajax: {
                url: '@Url.Action("GetInductionPresenceData", "Report")',
                type: 'GET',
                data: function (d) { d.date = $('#datepicker').val(); },
                dataSrc: function (json) {
                    var count = Array.isArray(json) ? json.length : 0;
                    $('#recordCount').text(count > 0 ? `${count} participant(s)` : '');
                    if (count === 0) {
                        $('#emptyState').removeClass('hidden');
                        $('#presenceTable').addClass('hidden');
                    } else {
                        $('#emptyState').addClass('hidden');
                        $('#presenceTable').removeClass('hidden');
                    }
                    return json;
                }
            },
            columns: [
                { data: 'userName', render: function(data) { return data || '-'; } },
                { data: 'employeeName', render: function(data) { return data || '-'; } },
                {
                    data: 'trainingDate',
                    render: function (data) {
                        if (!data) return '-';
                        var dt = new Date(data);
                        if (isNaN(dt.getTime())) return '-';
                        var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                        return `${String(dt.getDate()).padStart(2,'0')}-${monthNames[dt.getMonth()]}-${dt.getFullYear()}`;
                    }
                },
                { data: 'department', render: function(data) { return data || '-'; } },
                {
                    data: 'trainingType',
                    render: function(data) {
                        var label = 'Induction';
                        var color = 'background-color:#dbeafe; color:#1e40af;';
                        return `<span style="display:inline-flex; align-items:center; padding:2px 10px; border-radius:9999px; font-size:12px; font-weight:600; ${color}">${label}</span>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    render: function(data, type, row) {
                        var trainingId = $('#Computer_DropDown').val();
                        var participantId = row.id; 
                        if (!trainingId || !participantId) {
                            return '<span class="text-gray-400 text-xs">N/A</span>';
                        }
                        var finalTestUrl = '@Url.Action("PrintQuiz", "Result")' + '?trainingId=' + encodeURIComponent(trainingId) + '&participantId=' + encodeURIComponent(participantId);
                        return `
                            <div style="display:flex; gap:8px; justify-content:center;">
                                <a href="${finalTestUrl}" target="_blank" style="display:inline-flex; align-items:center; gap:4px; padding:4px 8px; border-radius:6px; font-size:11px; font-weight:600; background:#dc2626; color:white; text-decoration:none;" title="Final Test">Final</a>
                            </div>
                        `;
                    }
                }
            ],
            paging: false,
            searching: false,
            info: false,
            responsive: true,
            scrollY: '55vh',
            scrollCollapse: true,
            dom: 't',
            order: [[1, 'asc']],
            language: { emptyTable: "No attendance data available" }
        });

        $('#Computer_DropDown').on('change', function () { loadTable(); });
        function loadTable() { if (table) table.ajax.reload(); }

        $('#btnPreviewForm').on('click', function () {
            var date = $('#datepicker').val();
            var trainingId = $('#Computer_DropDown').val();
            if (!date || !trainingId) { alert('Please select date and training first'); return; }
            var url = '@Url.Action("PreviewTrainingFormAdmin", "Report")' + '?date=' + encodeURIComponent(date) + '&trainingId=' + encodeURIComponent(trainingId);
            window.open(url, '_blank');
        });

        // FIX: Export Excel Logic
        $('#btnExcel').on('click', function () {
            var date = $('#datepicker').val();
            var trainingId = $('#Computer_DropDown').val();
            
            if (!date) {
                alert('Please select a date first');
                return;
            }

            var wb = XLSX.utils.book_new();
            var exportData = [['No Badge', 'Employee Name', 'Training Date', 'Department', 'Training Type']];

            table.rows().every(function () {
                var row = this.data();
                if (row) {
                    var trainingDate = '-';
                    if (row.trainingDate) {
                        var dt = new Date(row.trainingDate);
                        if (!isNaN(dt.getTime())) {
                            var monthNames = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
                            trainingDate = `${String(dt.getDate()).padStart(2,'0')}-${monthNames[dt.getMonth()]}-${dt.getFullYear()}`;
                        }
                    }
                    
                    exportData.push([
                        row.userName || '-',
                        row.employeeName || '-',
                        trainingDate,
                        row.department || '-',
                        'Induction'
                    ]);
                }
            });

            var ws = XLSX.utils.aoa_to_sheet(exportData);
            ws['!cols'] = [{ wch: 15 }, { wch: 25 }, { wch: 15 }, { wch: 20 }, { wch: 12 }];
            XLSX.utils.book_append_sheet(wb, ws, 'Attendance');
            XLSX.writeFile(wb, 'Induction_Admin_Report_' + date + '.xlsx');
        });
    });
    </script>

    <style>
        .ui-datepicker { background: white; border: 2px solid #3b82f6; border-radius: 12px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1); padding: 10px; }
        .ui-datepicker-header { background: linear-gradient(to right, #3b82f6, #6366f1); color: white; font-weight: 600; border: none; border-radius: 8px 8px 0 0; padding: 10px; }
        .ui-datepicker-prev, .ui-datepicker-next { color: white !important; }
        .ui-datepicker-calendar th { color: #6b7280; font-weight: 600; padding: 8px; }
        .ui-datepicker-calendar td { padding: 4px; }
        .ui-datepicker-calendar a { color: #1f2937; font-weight: 500; border-radius: 6px; transition: all 0.2s; display: block; padding: 4px; }
        .ui-datepicker-calendar a:hover { background: #dbeafe; color: #1e40af; }
        .ui-datepicker-calendar .ui-state-active { background: #3b82f6 !important; color: white !important; }
        .training-day a { background-color: #16a34a !important; color: #fff !important; font-weight: 600; border-radius: 6px !important; }
        .training-day a:hover { background-color: #15803d !important; transform: scale(1.05); }
        
        #presenceTable_wrapper { font-family: 'Inter', sans-serif; }
        #presenceTable tbody tr { background: white; transition: all 0.2s; border-bottom: 1px solid #f3f4f6; }
        #presenceTable tbody td { padding: 14px 16px; color: #4b5563; border: none; text-align: left !important; vertical-align: middle; }
        #presenceTable thead th { font-weight: 600; color: #374151; padding: 12px 16px; border-bottom: 2px solid #e5e7eb; position: sticky; top: 0; background: white; z-index: 10; text-align: left !important; }
        #presenceTable tbody tr:hover { background: #f9fafb; }
    </style>
}