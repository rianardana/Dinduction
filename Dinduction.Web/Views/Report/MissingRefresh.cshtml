@model Dinduction.Web.Models.ParticipantUserVM
@{
    ViewData["Title"] = "Peserta Belum Selesai Refresh";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-red-50 to-orange-100 py-8 px-4">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-6 border-l-4 border-red-500 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Peserta Belum Selesai Refresh</h1>
                <p class="text-gray-500 mt-1">Daftar peserta yang terdaftar namun belum mengisi Post-Test Refresh.</p>
            </div>
            <div class="text-right hidden md:block">
                <span class="block text-sm text-gray-500">Tanggal Terpilih:</span>
                <span class="text-xl font-bold text-red-600">@Model.TrainingDate.ToString("dd-MMM-yyyy")</span>
            </div>
        </div>

        <!-- Filter & Actions -->
        <div class="bg-white rounded-2xl shadow-md p-6 mb-6">
             <form asp-action="MissingRefresh" method="get" class="flex flex-col md:flex-row gap-4 items-end">
                <div class="w-full md:w-1/3">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 inline-block mr-1 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Pilih Tanggal Refresh
                    </label>
                    <!-- ✅ GANTI ID JADI missingDatepicker AGAR TIDAK KONFLIK -->
                    <input type="text" 
                           id="missingDatepicker" 
                           name="date" 
                           value="@Model.TrainingDate.ToString("yyyy-MM-dd")" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-200 shadow-sm"
                           autocomplete="off" 
                           placeholder="Pick a date with Refresh Training" />
                </div>
                
                <div class="flex gap-2 w-full md:w-auto">
                  <!-- Button Cek Data -->
<button type="submit" 
        style="background-color: #dc2626 !important; color: white !important;"
        class="flex-1 md:flex-none px-6 py-3 font-semibold rounded-lg transition shadow-md flex items-center justify-center gap-2 hover:bg-red-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    Cek Data
</button>

<!-- Button Export Excel -->
<a href="@Url.Action("ExportMissingRefreshToExcel", "Report", new { date = Model.TrainingDate.ToString("yyyy-MM-dd") })" 
   style="background-color: #16a34a !important; color: white !important;"
   class="flex-1 md:flex-none px-6 py-3 font-semibold rounded-lg transition shadow-md flex items-center justify-center gap-2 hover:bg-green-700">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
    </svg>
    Export Excel
</a>
                </div>
             </form>
        </div>

        <!-- Table Result -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
            <div class="px-6 py-4 bg-red-50 border-b border-red-100 flex justify-between items-center">
                <h3 class="text-lg font-semibold text-red-800">
                    Hasil Pencarian (@(Model.Participants != null ? Model.Participants.Count : 0) Peserta)
                </h3>
                @if(Model.Participants != null && Model.Participants.Any())
                {
                    <span class="text-xs text-red-600 bg-red-100 px-2 py-1 rounded">Perlu Tindak Lanjut</span>
                }
            </div>
            
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No Badge</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Department</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model.Participants != null && Model.Participants.Any())
                    {
                        foreach (var p in Model.Participants)
                        {
                            <tr class="hover:bg-red-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">@p.UserName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@p.EmployeeName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@p.Department</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800 border border-red-200">
                                        Belum Refresh
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center">
                                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-4">
                                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                </div>
                                <p class="text-lg font-medium text-gray-900">Semua peserta sudah menyelesaikan Post-Test! 🎉</p>
                                <p class="text-sm text-gray-500 mt-1">Tidak ada data yang perlu ditindaklanjuti.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="mt-6 flex justify-between">
            <a href="@Url.Action("GetPresence", "Report")" class="text-blue-600 hover:text-blue-800 font-medium flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m7 7H3"></path></svg>
                Back to Attendance Report
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Styles & Scripts for Datepicker (COPIED FROM GetPresence) -->
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" asp-append-version="true" />
    <script src="~/js/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js" asp-append-version="true"></script>

    <script>
$(document).ready(function () {
    var refreshDates = [];

    // --- DEBUG MODE: HARDCODE TANGGAL YANG KITA TAHU ADA REFRESH ---
    // Hapus baris ini nanti jika endpoint sudah beres
    refreshDates = ["2026-06-15", "2026-06-12"]; 

    /* 
    // --- KODE ASLI (NON-AKTIF SEMENTARA) ---
    $.ajax({
        url: '@Url.Action("GetRefreshTrainingDates", "Report")', 
        method: 'GET',
        success: function (data) {
            refreshDates = Array.isArray(data) ? data : [];
            console.log("✅ Refresh Dates Loaded from Server:", refreshDates);
            initializeDatepicker();
        },
        error: function (xhr, status, error) {
            console.error(" Failed to load refresh dates:", error);
            // Fallback ke hardcoded jika error
            refreshDates = ["2026-06-15"]; 
            initializeDatepicker();
        }
    });
    */

    // Langsung init karena kita pakai hardcoded
    initializeDatepicker();

    function initializeDatepicker() {
        $("#missingDatepicker").datepicker({
            dateFormat: "yy-mm-dd",
            beforeShowDay: function (date) {
                var dateStr = $.datepicker.formatDate("yy-mm-dd", date);
                
                // Cek apakah tanggal ini ada di array refreshDates
                if (refreshDates.indexOf(dateStr) !== -1) {
                    // Return [true, 'css-class', 'tooltip']
                    return [true, "refresh-day-highlight", "Ada Refresh Training"];
                }
                return [true, "", ""];
            }
        });
    }
});
</script>

    <!-- ✅ STYLE DATEPICKER YANG HILANG DI FILE SEBELUMNYA -->
    <style>
        /* Datepicker Styling (Same as GetPresence) */
        .ui-datepicker {
            background: white;
            border: 2px solid #dc2626; /* Red border for this page */
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            padding: 10px;
            z-index: 100 !important;
        }
        .ui-datepicker-header {
            background: linear-gradient(to right, #dc2626, #ea580c); /* Red-Orange Gradient */
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 8px 8px 0 0;
            padding: 10px;
        }
        .ui-datepicker-prev, .ui-datepicker-next { color: white !important; }
        .ui-datepicker-calendar th { color: #6b7280; font-weight: 600; padding: 8px; }
        .ui-datepicker-calendar td { padding: 4px; }
        .ui-datepicker-calendar a {
            color: #1f2937; font-weight: 500; border-radius: 6px;
            transition: all 0.2s; display: block; padding: 4px;
        }
        .ui-datepicker-calendar a:hover { background: #fee2e2; color: #dc2626; }
        .ui-datepicker-calendar .ui-state-active {
            background: #dc2626 !important; color: white !important;
        }

        /* Highlight warna Hijau untuk tanggal Refresh */
         .refresh-day-highlight a {
        background-color: #16a34a !important; /* HIJAU */
        color: #fff !important;
        font-weight: 800 !important;
        border: 2px solid #15803d !important;
        border-radius: 50% !important; /* Biar bulat kalau mau */
    }
        .refresh-day-highlight a:hover {
            background-color: #15803d !important; /* Green-700 */
            transform: scale(1.1);
        }
    </style>
}