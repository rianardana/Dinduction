@model IEnumerable<Dinduction.Web.Models.QuestionVM>

<div class="max-w-6xl mx-auto px-4 py-6">

    <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-gray-900">Master Question Table</h1>
    </div>

    <div class="mb-6">
        <label for="sectionFilter" class="block text-sm font-medium text-gray-700 mb-2">Filter by Section</label>
        <select id="sectionFilter" class="w-full max-w-md px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <option value="">All Sections</option>
            @if (Model != null && Model.Any())
            {
                var sections = Model.Select(q => q.SectionName).Distinct().OrderBy(s => s);
                foreach (var sec in sections)
                {
                    if (!string.IsNullOrEmpty(sec))
                    {
                        <option value="@sec">@sec</option>
                    }
                }
            }
        </select>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Section</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Training</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Number</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Question</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Image</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors duration-150 question-row" data-filter="@item.SectionName">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@item.SectionName</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@item.TrainingName</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@item.Number</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@item.QuestionTraining</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (!string.IsNullOrEmpty(item.ImageQuestion))
                                    {
                                        <img src="@Url.Content("~/Images/" + item.ImageQuestion)" alt="Question Image" class="max-w-16 h-auto rounded border border-gray-200" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 px-6 py-3 bg-gray-50 rounded-lg border border-gray-200">
            <p class="text-sm text-gray-600">Showing <span id="visibleCount" class="font-semibold text-gray-900">@Model.Count()</span> of <span class="font-semibold text-gray-900">@Model.Count()</span> question(s)</p>
        </div>
    }
    else
    {
        <div class="bg-white border-2 border-dashed border-gray-300 rounded-xl p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <h3 class="mt-4 text-lg font-semibold text-gray-900">No questions yet</h3>
            <p class="mt-2 text-sm text-gray-600">Get started by adding new questions.</p>
        </div>
    }

    <div class="text-center mt-8 mb-6">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm hover:shadow-md">
                <svg class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Back to Home
            </a>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sectionFilter = document.getElementById('sectionFilter');
    const rows = document.querySelectorAll('.question-row');
    const visibleCount = document.getElementById('visibleCount');
    const totalCount = rows.length;

    sectionFilter.addEventListener('change', function() {
        const selectedSection = this.value;
        let visible = 0;

        rows.forEach(function(row) {
            const rowSection = row.getAttribute('data-filter');
            
            if (selectedSection === '' || rowSection === selectedSection) {
                row.style.display = '';
                visible++;
            } else {
                row.style.display = 'none';
            }
        });

        if (visibleCount) {
            visibleCount.textContent = visible;
        }
    });
});
</script>
