@model Dinduction.Web.Models.UserLearningMaterialVM
@{
    ViewData["Title"] = "View Material";
    int trainingId = 0;
    if (ViewBag.TrainingId is int tid) trainingId = tid;
}

<style>
    /* Font local/system fallback */

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --navy: #0f172a;
        --navy-mid: #1e293b;
        --navy-light: #334155;
        --accent: #3b82f6;
        --accent-glow: rgba(59,130,246,0.25);
        --border: rgba(255,255,255,0.08);
        --text: #f1f5f9;
        --text-muted: #94a3b8;
    }

    html, body {
        height: 100%;
        font-family: 'Sora', sans-serif;
        background: var(--navy);
        color: var(--text);
        overflow: hidden;
    }

    .shell {
        display: grid;
        grid-template-rows: 56px 1fr 52px;
        height: 100dvh;
        width: 100vw;
    }

    /* TOP BAR */
    .topbar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0 16px;
        background: var(--navy-mid);
        border-bottom: 1px solid var(--border);
        z-index: 10;
    }

    .topbar-icon {
        width: 32px; height: 32px;
        background: var(--accent);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 0 12px var(--accent-glow);
    }

    .topbar-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    .topbar-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--accent);
        background: var(--accent-glow);
        border: 1px solid rgba(59,130,246,0.3);
        padding: 3px 8px;
        border-radius: 20px;
        flex-shrink: 0;
    }

    .btn-back-top {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
        border-radius: 8px;
        font-family: 'Sora', sans-serif;
        font-size: 0.78rem;
        text-decoration: none;
        flex-shrink: 0;
        transition: all 0.18s ease;
    }

    .btn-back-top:hover { color: var(--text); border-color: var(--accent); }

    /* VIEWER */
    .viewer {
        position: relative;
        overflow: hidden;
        background: #0b111e;
        display: flex;
        flex-direction: column;
    }

    .progress-bar {
        position: absolute;
        top: 0; left: 0;
        height: 2px;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent-glow);
        transition: width 0.3s ease;
        z-index: 20;
        width: 0%;
    }

    .loading-screen {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 5;
        background: #0b111e;
        transition: opacity 0.4s ease;
    }

    .loading-screen.hidden { opacity: 0; pointer-events: none; }

    .spinner {
        width: 40px; height: 40px;
        border: 3px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .loading-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        text-align: center;
        padding: 0 20px;
        line-height: 1.6;
    }

    #pdf-scroll {
        flex: 1;
        width: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        background: #0b111e;
    }

   .page-wrapper {
    display: flex;
    justify-content: center;
    padding: 8px 0;
    width: 100%;
    overflow: hidden;
}

.page-wrapper canvas {
    display: block;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    background: white;
}

    .page-placeholder {
        width: 100%;
        background: #1a2332;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        aspect-ratio: 1 / 1.414;
    }

    /* QUIZ OVERLAY */
    .quiz-overlay {
        position: absolute;
        inset: 0;
        background: rgba(11, 17, 30, 0.93);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        z-index: 30;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 32px;
    }

    .quiz-overlay.visible {
        opacity: 1;
        pointer-events: all;
    }

    .quiz-overlay-icon {
        font-size: 3.5rem;
        animation: float 2s ease-in-out infinite alternate;
    }

    @@keyframes float {
        from { transform: translateY(0px); }
        to   { transform: translateY(-10px); }
    }

    .quiz-overlay-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text);
        text-align: center;
        line-height: 1.4;
    }

    .quiz-overlay-sub {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-align: center;
        line-height: 1.6;
    }

    .btn-quiz {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 32px;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 12px;
        font-family: 'Sora', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 0 28px var(--accent-glow);
        transition: all 0.2s ease;
        -webkit-tap-highlight-color: transparent;
        margin-top: 8px;
    }

    .btn-quiz:hover { transform: scale(1.04); box-shadow: 0 0 40px var(--accent-glow); color: white; }
    .btn-quiz:active { transform: scale(0.97); }

    .btn-quiz-back {
        font-size: 0.78rem;
        color: var(--text-muted);
        background: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 20px;
        cursor: pointer;
        font-family: 'Sora', sans-serif;
        -webkit-tap-highlight-color: transparent;
        transition: all 0.18s ease;
    }

    .btn-quiz-back:hover { color: var(--text); border-color: var(--text-muted); }

    /* BOTTOM BAR */
    .bottombar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        background: var(--navy-mid);
        border-top: 1px solid var(--border);
        gap: 10px;
        flex-shrink: 0;
    }

    .nav-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border: 1px solid var(--border);
        background: var(--navy-light);
        color: var(--text);
        border-radius: 8px;
        font-family: 'Sora', sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.18s ease;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
    }

    .nav-btn:active { transform: scale(0.96); background: var(--accent); }
    .nav-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .nav-btn:not(:disabled):hover { background: var(--accent); border-color: var(--accent); }

    .page-info {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: var(--text-muted);
        text-align: center;
        flex: 1;
        white-space: nowrap;
    }

    .page-info span { color: var(--accent); font-weight: 600; }
</style>

<div class="shell">

    <div class="topbar">
        <a href="@Url.Action("Study", "Learning", new { trainingId = trainingId })" class="btn-back-top">← Back</a>
        <div class="topbar-icon">📄</div>
        <div class="topbar-title">@(Model?.Title ?? "Untitled")</div>
        <div class="topbar-badge" id="page-badge">PDF</div>
    </div>

    <div class="viewer">
        <div class="progress-bar" id="progress-bar"></div>

        @if (!string.IsNullOrEmpty(Model?.FilePath))
        {
            <div class="loading-screen" id="loading-screen">
                <div class="spinner"></div>
                <div class="loading-text" id="loading-text">Loading document...</div>
            </div>

            <div id="pdf-scroll"></div>

            <!-- Quiz overlay — muncul di halaman terakhir -->
            <div class="quiz-overlay" id="quiz-overlay">
                <div class="quiz-overlay-icon">🎉</div>
                <div class="quiz-overlay-title">Materi selesai dibaca!</div>
                <div class="quiz-overlay-sub">Kamu sudah menyelesaikan semua halaman.<br>Siap untuk melanjutkan ke quiz?</div>
                <form method="post" action="@Url.Action("MarkCompleteAndRedirect", "Learning")" id="quiz-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="materialId" value="@Model.Id" />
                    <input type="hidden" name="trainingId" value="@trainingId" />
                    <button type="submit" class="btn-quiz">
                        🚀 Lanjutkan Quiz
                    </button>
                </form>
                <button class="btn-quiz-back" onclick="closeQuizOverlay()">← Kembali ke Materi</button>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div style="font-size:3rem;opacity:0.4">📭</div>
                <div style="font-size:0.9rem">No file available.</div>
            </div>
        }
    </div>

    <div class="bottombar">
        <button class="nav-btn" id="btn-prev" onclick="prevPage()" disabled>◀ Prev</button>
        <div class="page-info">
            <span id="cur-page">—</span> / <span id="tot-page">—</span>
        </div>
        <button class="nav-btn" id="btn-next" onclick="nextPage()" disabled>Next ▶</button>
    </div>

</div>

@if (!string.IsNullOrEmpty(Model?.FilePath))
{
    <script src="~/lib/pdfjs/pdf.min.js" asp-append-version="true"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = '@Url.Content("~/lib/pdfjs/pdf.worker.min.js")';

        const FILE_URL    = '@Model.FilePath';
        const pdfScroll   = document.getElementById('pdf-scroll');
        const loading     = document.getElementById('loading-screen');
        const loadingTxt  = document.getElementById('loading-text');
        const btnPrev     = document.getElementById('btn-prev');
        const btnNext     = document.getElementById('btn-next');
        const curPageEl   = document.getElementById('cur-page');
        const totPageEl   = document.getElementById('tot-page');
        const progressEl  = document.getElementById('progress-bar');
        const pageBadge   = document.getElementById('page-badge');
        const quizOverlay = document.getElementById('quiz-overlay');

        let pdfDoc = null, pageCount = 0, currentPage = 1, renderQueue = {};
        let quizShown = false;

            function getScale() {
            const dpr = window.devicePixelRatio || 1;
            const containerW = pdfScroll.clientWidth - 32; 
            return (containerW / 595) * dpr;
        }

        async function renderPage(num) {
            if (renderQueue[num]) return;
            renderQueue[num] = true;

            const wrapper = document.getElementById('page-wrap-' + num);
            if (!wrapper) return;

            const page = await pdfDoc.getPage(num);
            
            // Ambil viewport asli dulu untuk tahu aspect ratio PDF
            const vpNatural = page.getViewport({ scale: 1 });
            
            // Hitung scale berdasarkan lebar container yang tersedia
            const containerW = pdfScroll.clientWidth;
            const dpr = window.devicePixelRatio || 1;
            const scale = (containerW / vpNatural.width) * dpr;
            
            const vp = page.getViewport({ scale });

            const canvas = document.createElement('canvas');
            canvas.width  = vp.width;
            canvas.height = vp.height;
            // CSS: tampilkan full width, height auto (aspect ratio terjaga)
            canvas.style.width  = containerW + 'px';
            canvas.style.height = 'auto';
            canvas.style.display = 'block';

            wrapper.innerHTML = '';
            wrapper.appendChild(canvas);

            await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;

            const done = Object.keys(renderQueue).length;
            progressEl.style.width = Math.round((done / pageCount) * 100) + '%';
            if (done === pageCount) progressEl.style.opacity = '0';
        }

        function renderVisible() {
            const scrollTop = pdfScroll.scrollTop;
            const viewH = pdfScroll.clientHeight;
            const buffer = viewH * 2;

            for (let n = 1; n <= pageCount; n++) {
                const wrap = document.getElementById('page-wrap-' + n);
                if (!wrap) continue;
                const top = wrap.offsetTop;
                const bot = top + wrap.offsetHeight;
                if (bot >= scrollTop - buffer && top <= scrollTop + viewH + buffer) {
                    renderPage(n);
                }
            }
        }

        function updateCurrentPage() {
            const scrollTop = pdfScroll.scrollTop;
            const viewMid = scrollTop + pdfScroll.clientHeight / 2;

            for (let n = 1; n <= pageCount; n++) {
                const wrap = document.getElementById('page-wrap-' + n);
                if (!wrap) continue;
                const top = wrap.offsetTop;
                const bot = top + wrap.offsetHeight;
                if (viewMid >= top && viewMid < bot) {
                    if (currentPage !== n) {
                        currentPage = n;
                        curPageEl.textContent = n;
                        pageBadge.textContent = n + ' / ' + pageCount;
                        updateNavButtons();

                        // Tampilkan quiz overlay saat halaman terakhir
                        if (n === pageCount && !quizShown) {
                            setTimeout(() => {
                                quizOverlay.classList.add('visible');
                                quizShown = true;
                            }, 600);
                        }
                    }
                    break;
                }
            }
        }

        function closeQuizOverlay() {
            quizOverlay.classList.remove('visible');
        }

        async function loadPDF() {
            try {
                loadingTxt.textContent = 'Connecting...';
                const test = await fetch(FILE_URL, { method: 'HEAD' });
                if (!test.ok) { showError('File tidak ditemukan (HTTP ' + test.status + ')'); return; }

                loadingTxt.textContent = 'Loading PDF...';
                pdfDoc    = await pdfjsLib.getDocument({ url: FILE_URL, isEvalSupported: false }).promise;
                pageCount = pdfDoc.numPages;
                totPageEl.textContent = pageCount;
                curPageEl.textContent = 1;
                pageBadge.textContent = '1 / ' + pageCount;

                for (let n = 1; n <= pageCount; n++) {
                    const wrap = document.createElement('div');
                    wrap.className = 'page-wrapper';
                    wrap.id = 'page-wrap-' + n;
                    const placeholder = document.createElement('div');
                    placeholder.className = 'page-placeholder';
                    placeholder.textContent = 'Halaman ' + n;
                    wrap.appendChild(placeholder);
                    pdfScroll.appendChild(wrap);
                }

                loading.classList.add('hidden');
                updateNavButtons();
                renderVisible();

                pdfScroll.addEventListener('scroll', () => {
                    updateCurrentPage();
                    renderVisible();
                }, { passive: true });

            } catch (e) {
                showError(e.message);
            }
        }

        function showError(msg) {
            loading.innerHTML = '<div style="font-size:2.5rem;opacity:0.5">⚠️</div><div class="loading-text" style="color:#f87171">' + msg + '</div>';
        }

        function prevPage() {
            if (currentPage > 1) scrollToPage(currentPage - 1);
        }

        function nextPage() {
            if (currentPage < pageCount) scrollToPage(currentPage + 1);
        }

        function scrollToPage(num) {
            const wrap = document.getElementById('page-wrap-' + num);
            if (wrap) wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function updateNavButtons() {
            btnPrev.disabled = currentPage <= 1;
            btnNext.disabled = currentPage >= pageCount;
        }

        // Swipe iOS
        let touchStartX = 0, touchStartY = 0;
        pdfScroll.addEventListener('touchstart', e => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });
        pdfScroll.addEventListener('touchend', e => {
            const dx = touchStartX - e.changedTouches[0].screenX;
            const dy = Math.abs(touchStartY - e.changedTouches[0].screenY);
            if (Math.abs(dx) > 60 && Math.abs(dx) > dy) {
                if (dx > 0) nextPage(); else prevPage();
            }
        }, { passive: true });

        loadPDF();
    </script>
}
