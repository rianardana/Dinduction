@model Dinduction.Web.Models.LearningStudyVM
@{
    ViewData["Title"] = "Study Materials";
}

<style>
    body {
        background-color: #f8fafc;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }
    .user-card {
        background: white;
        border-radius: 12px;
        padding: 16px;
        margin: 16px auto 24px;
        max-width: 500px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        border: 1px solid #e5e7eb;
    }
    .user-card h5 { font-weight: 600; margin: 0; color: #1e3a8a; }
    .user-card p { margin: 4px 0 0; font-size: 0.875rem; color: #64748b; }
    
    .progress-container {
        background: white; border-radius: 12px; padding: 20px;
        margin: 0 auto 24px; max-width: 500px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;
    }
    .progress-header { display: flex; justify-content: space-between; margin-bottom: 12px; }
    .progress-title { font-weight: 600; color: #1e3a8a; }
    .progress-percent { font-weight: 700; color: #2563eb; font-size: 1.25rem; }
    .progress-bar { width: 100%; height: 12px; background: #e5e7eb; border-radius: 6px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #2563eb); transition: width 0.3s ease; }
    .progress-fill.completed { background: linear-gradient(90deg, #22c55e, #15803d); }
    .progress-info { text-align: center; margin-top: 8px; font-size: 0.875rem; color: #64748b; }

    .material-card {
        background: white; border-radius: 12px; padding: 16px; margin: 8px 0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05); border: 1px solid #e5e7eb;
        transition: all 0.2s ease; display: flex; align-items: center; min-height: 80px; position: relative;
    }
    .material-card:hover { transform: translateY(-4px); box-shadow: 0 6px 12px rgba(0,0,0,0.08); }
    .material-card.completed { border-color: #22c55e; background: #f0fdf4; }
    
    .material-icon {
        width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;
        font-size: 2rem; margin-right: 12px; background: #f1f5f9; border-radius: 8px; flex-shrink: 0;
    }
    .material-info { flex: 1; }
    .material-title { font-weight: 600; color: #1e3a8a; font-size: 0.95rem; margin-bottom: 4px; }
    .material-status { font-size: 0.75rem; color: #64748b; }
    .material-status.completed { color: #15803d; font-weight: 600; }
    
    .status-badge {
        position: absolute; top: 12px; right: 12px; padding: 4px 10px;
        border-radius: 20px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase;
    }
    .status-pending { background: #f1f5f9; color: #64748b; }
    .status-completed { background: #dcfce7; color: #15803d; }
    
    .btn-view {
        display: inline-flex; align-items: center; padding: 8px 16px;
        background: #2563eb; color: white; border-radius: 8px;
        font-size: 0.875rem; font-weight: 500; text-decoration: none;
    }
    .btn-view:hover { background: #1d4ed8; }
    
    .btn-complete {
        display: inline-flex; align-items: center; padding: 8px 16px;
        background: #22c55e; color: white; border-radius: 8px;
        font-size: 0.875rem; font-weight: 500; border: none; cursor: pointer;
    }
    .btn-complete:hover { background: #15803d; }
    
    .btn-next {
        display: inline-flex; align-items: center; padding: 12px 24px;
        background: linear-gradient(90deg, #22c55e, #15803d); color: white;
        border-radius: 10px; font-size: 1rem; font-weight: 600; text-decoration: none;
    }
    .btn-back {
        display: inline-flex; align-items: center; padding: 12px 24px;
        background: #64748b; color: white; border-radius: 10px;
        font-size: 1rem; text-decoration: none;
    }
    .action-row { display: flex; gap: 8px; }
    .empty-state { text-align: center; padding: 40px 20px; background: white; border-radius: 12px; border: 1px solid #e5e7eb; }
</style>

<div class="px-4 py-6">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-xl font-bold text-gray-800 text-center mb-6">
            📚 @Model.TrainingName
        </h2>

        <div class="user-card">
            <h5>👋 Hi, @Model.EmployeeName</h5>
            <p>Badge: @Model.EmployeeNumber</p>
        </div>

        <div class="progress-container">
            <div class="progress-header">
                <span class="progress-title">Learning Progress</span>
                <span class="progress-percent">@Model.ProgressPercent%</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill @(Model.IsAllCompleted ? "completed" : "")" 
                     style="width: @Model.ProgressPercent%"></div>
            </div>
            <div class="progress-info">
                @Model.CompletedMaterials of @Model.TotalMaterials materials completed
            </div>
        </div>

        <!-- ✅ Materials List - Pake @Model.Materials (DARI CONTROLLER!) -->
        @if (Model.Materials != null && Model.Materials.Any())
        {
            <div class="space-y-3">
                @foreach (var material in Model.Materials)  
                {
                    <div class="material-card @(material.IsCompleted ? "completed" : "")">
                        <div class="material-icon">@material.DisplayIcon</div>
                        <div class="material-info">
                            <div class="material-title">@material.Title</div>
                            <div class="material-status @(material.IsCompleted ? "completed" : "")">
                                @(material.IsCompleted ? "✅ Completed" : "⏳ Pending")
                            </div>
                        </div>
                        @* <span class="status-badge @(material.IsCompleted ? "status-completed" : "status-pending")">
                            @(material.IsCompleted ? "Done" : "New")
                        </span> *@
                       <div class="action-row">
                            @if (material.IsCompleted)
                            {
                                // ✅ Ambil target quiz no dari ViewBag (sudah di-set controller)
                                var targetQuizNo = ViewBag.TargetQuizNo ?? 1;
                                
                                <a href="@Url.Action("Record", "Quiz", new { id = Model.TrainingId, quizNo = targetQuizNo })" 
                                class="btn-complete"
                                style="background: #7c3aed;">
                                    🎯 Kerjakan Kuis
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("ViewMaterial", "Learning", new { materialId = material.Id, trainingId = Model.TrainingId })" 
                                class="btn-view">
                                    📖 Pelajari Materi
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

         
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <div class="empty-state-title">No Materials Found</div>
                <div class="empty-state-desc">
                    Training "@Model.TrainingName" has no materials yet.
                </div>
            </div>
        }

        <div class="text-center mt-8 mb-6">
            <a href="@Url.Action("Index", "Learning")" class="btn-back">← Back to Learning</a>
        </div>
    </div>
</div>